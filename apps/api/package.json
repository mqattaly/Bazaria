{
  "name": "@bazaria/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\" --noClear",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "user:create": "tsx scripts/create-user.ts",
    "membership:grant": "tsx scripts/grant-membership.ts",
    "platform-admin:create": "tsx scripts/create-platform-admin.ts"
  },
  "dependencies": {
    "@bazaria/shared": "*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "18.4.0-beta.17",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
