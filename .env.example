# Copy this file to `.env` and replace every placeholder before use.
# Never commit `.env` or real credentials. The values below are placeholders, not defaults.

NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# Browser origin allowed for CORS and CSRF Origin checks.
WEB_ORIGIN=http://localhost:5173
# Comma-separated additional origins if needed (e.g. preview URL).
WEB_ORIGINS_EXTRA=

# PostgreSQL roles and databases.
# Replace every YOUR_* placeholder with a locally generated password.
# `npm run db:start` reads the superuser password from DATABASE_ADMIN_URL.
# DATABASE_ADMIN_URL is used only by bootstrap/test utilities, never by the API.
DATABASE_ADMIN_URL=postgres://postgres:YOUR_ADMIN_PASSWORD@127.0.0.1:5433/bazaria
DATABASE_OWNER_URL=postgres://bazaria_owner:YOUR_OWNER_PASSWORD@127.0.0.1:5433/bazaria
DATABASE_URL=postgres://bazaria_app:YOUR_APP_PASSWORD@127.0.0.1:5433/bazaria
DATABASE_POOL_MAX=10

# Passwords for the two database login roles created by db:bootstrap.
DB_OWNER_PASSWORD=YOUR_OWNER_PASSWORD
DB_APP_PASSWORD=YOUR_APP_PASSWORD

# Session policy used by the implementation (hours).
SESSION_TTL_HOURS=12

# Grace period after the license validity date (whole days, UTC).
# 0 disables the grace period and moves the company straight to read-only.
# Invalid or negative values stop the API at startup.
SUBSCRIPTION_GRACE_DAYS=7

# Login throttling defaults.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PHONE=5
LOGIN_MAX_FAILURES_IP=20

# Set true only behind HTTPS.
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the API (leave empty locally).
# TRUST_PROXY=1

# CLI provisioning (never put real production secrets here).
# USER_PASSWORD=
# PLATFORM_ADMIN_PHONE=
# PLATFORM_ADMIN_NAME=
# PLATFORM_ADMIN_PASSWORD=
